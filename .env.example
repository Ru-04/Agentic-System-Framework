# Copy to .env for local development. Placeholders only: never commit real values.
# Profiles: development | test | production (production refuses to start unless all
# required production settings are present; see Increment 1 plan, T2).
WEBDESK_ENV=development

# PostgreSQL (migrations run as the owner role; the app runs as the restricted app role)
# Local Docker Compose PostgreSQL is published on host port 5433 (see docker-compose.yml).
WEBDESK_DATABASE_URL=postgresql+psycopg://webdesk_owner:CHANGE_ME@localhost:5433/webdesk
WEBDESK_APP_DATABASE_URL=postgresql+psycopg://webdesk_app:CHANGE_ME@localhost:5433/webdesk

# Onboarding and ceremony configuration. Unset = fail closed for onboarding/ceremonies.
# An allowlist set to an empty value is deny-all.
WEBDESK_EMAIL_DOMAIN_ALLOWLIST=
WEBDESK_EMAIL_ALIAS_DENYLIST=
# WEBDESK_OWNER_PUBLIC_KEY_PATH=

# Non-production email capture sink (rejected when WEBDESK_ENV=production)
WEBDESK_EMAIL_TRANSPORT=capture

# Rate limits and outbox dead-letter threshold: unset = onboarding disabled.
# Recommended defaults from EVAL-F11e are documented in the spec; set them explicitly.
# WEBDESK_RL_LOGIN_FAILURES_PER_ACCOUNT_IP=
# WEBDESK_RL_LOGIN_WINDOW_MINUTES=
# WEBDESK_RL_IP_REQUESTS_PER_WINDOW=
# WEBDESK_RL_CONTACT_ACTIONS_PER_WINDOW=
# WEBDESK_RL_CONTACT_IP_REQUESTS_PER_WINDOW=
# WEBDESK_RL_WINDOW_MINUTES=
# WEBDESK_OUTBOX_DEAD_LETTER_THRESHOLD=
# Base64 of 32 random bytes. Generate per environment; never commit a real value.
# WEBDESK_OUTBOX_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
